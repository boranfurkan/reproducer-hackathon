# Copy to .env.local and fill in. Never commit real values.
GEMINI_API_KEY=
MONGODB_URI=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
# true: ping the warm sandbox every 9 minutes (up to about 72 minutes) so it keeps Playwright installed. Costs a few thousand tokens per ping.
KEEP_SANDBOX_WARM=true
# Optional: the model that runs inside the Antigravity sandbox agent (default gemini-4-argon).
# SANDBOX_AGENT_MODEL=gemini-3.8-flash
